<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="fedex_rest" translate="label" type="text" sortOrder="155"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>FedEx REST Integration</label>
                <field id="active" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="environment" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Environment</label>
                    <source_model>Vendor\FedExIntegration\Model\Config\Source\Environment</source_model>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key (Client ID)</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>FedEx OAuth client ID.</comment>
                    <validate>required-entry</validate>
                </field>
                <field id="secret_key" translate="label comment" type="obscure" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Secret Key (Client Secret)</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>FedEx OAuth client secret. This value is stored encrypted.</comment>
                    <validate>required-entry</validate>
                </field>
                <field id="account_number" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>FedEx Account Number</label>
                    <comment>Required by FedEx Rates and Ship APIs.</comment>
                    <validate>required-entry</validate>
                </field>
                <field id="shipper_company" translate="label comment" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Shipper Company</label>
                    <comment>Used as the default Ship API contact company.</comment>
                </field>
                <field id="shipper_phone" translate="label comment" type="text" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Shipper Phone</label>
                    <comment>Required by FedEx shipment creation.</comment>
                    <validate>validate-phoneStrict</validate>
                </field>
                <field id="allowed_methods" translate="label" type="multiselect" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allowed Methods</label>
                    <source_model>Vendor\FedExIntegration\Model\Config\Source\Method</source_model>
                </field>
                <field id="pickup_type" translate="label" type="select" sortOrder="100"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Pickup Type</label>
                    <source_model>Vendor\FedExIntegration\Model\Config\Source\PickupType</source_model>
                </field>
                <field id="packaging_type" translate="label" type="select" sortOrder="110"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Packaging Type</label>
                    <source_model>Vendor\FedExIntegration\Model\Config\Source\PackagingType</source_model>
                </field>
                <field id="default_weight_unit" translate="label" type="select" sortOrder="120"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Weight Unit</label>
                    <source_model>Vendor\FedExIntegration\Model\Config\Source\WeightUnit</source_model>
                </field>
                <field id="default_dimension_unit" translate="label" type="select" sortOrder="130"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Dimension Unit</label>
                    <source_model>Vendor\FedExIntegration\Model\Config\Source\DimensionUnit</source_model>
                </field>
                <field id="default_package_length" translate="label" type="text" sortOrder="140"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Package Length</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="default_package_width" translate="label" type="text" sortOrder="150"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Package Width</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="default_package_height" translate="label" type="text" sortOrder="160"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Default Package Height</label>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="timeout" translate="label comment" type="text" sortOrder="170"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Timeout (seconds)</label>
                    <comment>Maximum time to wait for FedEx REST API responses.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
                <field id="token_ttl_buffer" translate="label comment" type="text" sortOrder="180"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>OAuth Token Refresh Buffer (seconds)</label>
                    <comment>Token cache is refreshed this many seconds before FedEx expiration.</comment>
                    <validate>validate-number validate-zero-or-greater</validate>
                </field>
                <field id="specificerrmsg" translate="label" type="textarea" sortOrder="190"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Displayed Error Message</label>
                </field>
            </group>
        </section>
    </system>
</config>
